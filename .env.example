# ── Anthropic ─────────────────────────────────────────────────────
# Required for SDK-based classify + summary paths. Leave empty if you only use
# the `claude -p` subprocess path (which routes through your CC subscription).
ANTHROPIC_API_KEY=

# ── OpenRouter (alternative classifier) ───────────────────────────
# Required when running cli-csv with --classifier=openrouter
OPENROUTER_API_KEY=

# ── Claude Code CLI ───────────────────────────────────────────────
# Path to the `claude` binary used by tag-trade-cli.ts. Defaults to "claude"
# on PATH if unset. Override only if you have a non-standard install.
CLAUDE_BIN=claude

# ── Supabase (trader_intel schema + cross-schema MC writes) ───────
# Either pair works; the code accepts both naming conventions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Noah's secrets-file aliases (used by cli-csv when the above aren't set):
MC_V2_SUPABASE_URL=
MC_V2_SUPABASE_SECRET_KEY=

# ── Tradovate (production pipeline) ───────────────────────────────
# Demo:  https://demo.tradovateapi.com/v1
# Live:  https://live.tradovateapi.com/v1
TRADOVATE_API_URL=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
# App credentials from Tradovate developer portal (https://tradovate.com/developer-portal/)
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
# Numeric Tradovate account ID (NOT the prop firm account name)
TRADOVATE_ACCOUNT_ID=

# ── Telegram delivery ─────────────────────────────────────────────
# Bot token from @BotFather. Leave empty to skip delivery (markdown summary
# still writes to BRAIN_DAILY_PATH).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Local file outputs ────────────────────────────────────────────
# Where daily summaries get appended. Recommended: a path under your brain dir.
BRAIN_DAILY_PATH=
